---
import Button from "../Button.astro";
import Card from "../Card.astro";
import CaseStudyGallery from "./CaseStudyGallery.astro";
import { stackIcons } from "../../data/stack-icons";
import type { CaseStudy } from "../../types/case-study";

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const lead = study.lead ?? study.teaser;
const problemTitle = study.problemTitle ?? "Problem";
const solutionTitle = study.solutionTitle ?? "What shipped";
---

<div class="reveal md:col-span-2" style="animation-delay: 280ms">
  <Card
    title={study.trailLabel ?? study.client}
    meta={study.year}
    class="h-full"
  >
    <div class="flex flex-1 flex-col gap-5">
      <p class="max-w-xl text-xl leading-snug tracking-tight text-text-muted">
        {lead}{
          study.leadHighlight && (
            <span class="font-accent text-text-secondary">
              {" "}
              {study.leadHighlight}
            </span>
          )
        }
      </p>

      {
        study.context && (
          <p class="max-w-prose text-sm leading-relaxed text-text-secondary">
            {study.context}
          </p>
        )
      }

      {
        (study.liveUrl || study.repoUrl) && (
          <div class="flex flex-wrap gap-2">
            {study.liveUrl && (
              <Button href={study.liveUrl} size="compact" external>
                View the product
                <span class="sr-only"> (opens in a new tab)</span>
              </Button>
            )}
            {study.repoUrl && (
              <Button
                href={study.repoUrl}
                variant="secondary"
                size="compact"
                external
              >
                Repository
                <span class="sr-only"> (opens in a new tab)</span>
              </Button>
            )}
          </div>
        )
      }

      {
        study.results.length > 0 && (
          <dl class="grid gap-4 border-t border-border/30 pt-5 sm:grid-cols-3">
            {study.results.map((result) => (
              <div>
                <dt class="font-mono text-[0.625rem] tracking-[0.08em] text-text-muted uppercase">
                  {result.label}
                </dt>
                <dd class="mt-1 text-sm text-text-primary">{result.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </Card>
</div>

{
  study.gallery && study.gallery.length > 0 && (
    <CaseStudyGallery shots={study.gallery} />
  )
}

<div class="reveal h-full" style="animation-delay: 430ms">
  <Card title={problemTitle} class="h-full">
    <div class="flex flex-1 flex-col gap-4">
      {
        study.problemBeats && study.problemBeats.length > 0 && (
          <ol class="beat-list">
            {study.problemBeats.map((beat) => (
              <li>{beat}</li>
            ))}
          </ol>
        )
      }
      <p class="max-w-prose text-sm leading-relaxed text-text-secondary">
        {study.problem}
      </p>
    </div>
  </Card>
</div>

<div class="reveal h-full" style="animation-delay: 500ms">
  <Card title={solutionTitle} class="h-full">
    <div class="flex flex-1 flex-col gap-4">
      {
        study.solutionBeats && study.solutionBeats.length > 0 && (
          <ul class="beat-list">
            {study.solutionBeats.map((beat) => (
              <li>{beat}</li>
            ))}
          </ul>
        )
      }
      <p class="max-w-prose text-sm leading-relaxed text-text-secondary">
        {study.solution}
      </p>
    </div>
  </Card>
</div>

{
  study.stack.length > 0 && (
    <div class="reveal md:col-span-2" style="animation-delay: 570ms">
      <Card title="Stack" class="h-full">
        <ul class="stack-board" aria-label="Stack">
          {study.stack.map((name) => {
            const icon = stackIcons[name];
            return (
              <li class="stack-tool">
                {icon && (
                  <svg
                    class="stack-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path fill="currentColor" d={icon} />
                  </svg>
                )}
                <span>{name}</span>
              </li>
            );
          })}
        </ul>
      </Card>
    </div>
  )
}

<style>
  .beat-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .beat-list li {
    padding-block: 0.75rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 34%, transparent);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  .beat-list li:first-child {
    padding-top: 0;
  }

  .beat-list li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .stack-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-tool {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .stack-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
    color: var(--color-text-secondary);
    transition: color 0.25s ease;
  }

  @media (min-width: 640px) {
    .stack-board {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .stack-tool:hover .stack-icon {
      color: var(--color-text-primary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-icon {
      transition: none;
    }
  }
</style>
