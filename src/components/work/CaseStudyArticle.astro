---
import Button from "../Button.astro";
import Card from "../Card.astro";
import CaseStudyGallery from "./CaseStudyGallery.astro";
import { stackIcons } from "../../data/stack-icons";
import type { CaseStudy } from "../../types/case-study";

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const lead = study.lead ?? study.teaser;
const problemTitle = study.problemTitle ?? "Problem";
const solutionTitle = study.solutionTitle ?? "What shipped";
---

<div class="reveal md:col-span-2" style="animation-delay: 280ms">
  <Card
    title={study.trailLabel ?? study.client}
    meta={study.year}
    class="h-full"
  >
    <div class="flex flex-1 flex-col gap-5">
      <p class="max-w-xl text-xl leading-snug tracking-tight text-text-muted">
        {lead}{
          study.leadHighlight && (
            <span class="font-accent text-text-secondary">
              {" "}
              {study.leadHighlight}
            </span>
          )
        }
      </p>

      {
        study.context && (
          <p class="max-w-prose text-sm leading-relaxed text-text-secondary">
            {study.context}
          </p>
        )
      }

      {
        (study.liveUrl || study.repoUrl) && (
          <div class="flex flex-wrap gap-2">
            {study.liveUrl && (
              <Button href={study.liveUrl} size="compact" external>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-3.5"
                  aria-hidden="true"
                >
                  <path d="M7 7h10v10" />
                  <path d="M7 17 17 7" />
                </svg>
                See it live
                <span class="sr-only"> (opens in a new tab)</span>
              </Button>
            )}
            {study.repoUrl && (
              <Button
                href={study.repoUrl}
                variant="secondary"
                size="compact"
                external
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-3.5"
                  aria-hidden="true"
                >
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                  <path d="M9 18c-4.51 2-5-2-7-2" />
                </svg>
                Repository
                <span class="sr-only"> (opens in a new tab)</span>
              </Button>
            )}
          </div>
        )
      }

      {
        study.results.length > 0 && (
          <dl class="grid gap-4 border-t border-border/30 pt-5 sm:grid-cols-3">
            {study.results.map((result) => (
              <div>
                <dt class="font-mono text-xs tracking-[0.08em] text-text-muted uppercase">
                  {result.label}
                </dt>
                <dd class="mt-1 text-sm text-text-primary">{result.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </Card>
</div>

{
  study.gallery && study.gallery.length > 0 && (
    <CaseStudyGallery shots={study.gallery} />
  )
}

<div class="reveal h-full" style="animation-delay: 430ms">
  <Card title={problemTitle} class="h-full">
    <div class="flex flex-1 flex-col gap-4">
      {
        study.problemBeats && study.problemBeats.length > 0 && (
          <ol class="beat-list">
            {study.problemBeats.map((beat) => (
              <li>{beat}</li>
            ))}
          </ol>
        )
      }
      <p class="max-w-prose text-sm leading-relaxed text-text-secondary">
        {study.problem}
      </p>
    </div>
  </Card>
</div>

<div class="reveal h-full" style="animation-delay: 500ms">
  <Card title={solutionTitle} class="h-full">
    <div class="flex flex-1 flex-col gap-4">
      {
        study.solutionBeats && study.solutionBeats.length > 0 && (
          <ul class="beat-list">
            {study.solutionBeats.map((beat) => (
              <li>{beat}</li>
            ))}
          </ul>
        )
      }
      <p class="max-w-prose text-sm leading-relaxed text-text-secondary">
        {study.solution}
      </p>
    </div>
  </Card>
</div>

{
  study.stack.length > 0 && (
    <div class="reveal md:col-span-2" style="animation-delay: 570ms">
      <Card title="Stack" class="h-full">
        <div class="flex flex-1 flex-col">
          <ul class="stack-board" aria-label="Stack">
            {study.stack.map((name) => {
              const icon = stackIcons[name];
              return (
                <li class="stack-tool">
                  {icon && (
                    <svg
                      class="stack-icon"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path fill="currentColor" d={icon} />
                    </svg>
                  )}
                  <span>{name}</span>
                </li>
              );
            })}
          </ul>
          {study.liveUrl && (
            <div class="mt-5 border-t border-border/30 pt-5">
              <Button href={study.liveUrl} size="compact" external>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-3.5"
                  aria-hidden="true"
                >
                  <path d="M7 7h10v10" />
                  <path d="M7 17 17 7" />
                </svg>
                See it live
                <span class="sr-only"> (opens in a new tab)</span>
              </Button>
            </div>
          )}
        </div>
      </Card>
    </div>
  )
}

<style>
  .beat-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .beat-list li {
    padding-block: 0.75rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 34%, transparent);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-text-primary);
  }

  .beat-list li:first-child {
    padding-top: 0;
  }

  .beat-list li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .stack-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-tool {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .stack-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
    color: var(--color-text-secondary);
    transition: color 0.25s ease;
  }

  @media (min-width: 640px) {
    .stack-board {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .stack-tool:hover .stack-icon {
      color: var(--color-text-primary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-icon {
      transition: none;
    }
  }
</style>
