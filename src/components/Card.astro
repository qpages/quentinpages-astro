---
import { cn } from "../lib/cn";
import CardLabel from "./CardLabel.astro";

interface Props {
  title?: string;
  meta?: string;
  class?: string;
  href?: string;
  ariaLabel?: string;
}

const { title, meta, class: className, href, ariaLabel } = Astro.props;

const baseClass = cn(
  "flex min-h-48 flex-col rounded-[var(--radius-card)] border border-border/30 bg-surface/35 p-5 md:p-6",
  href &&
    "text-inherit no-underline transition-colors duration-200 hover:border-border/60 focus-visible:border-border-subtle focus-visible:outline-none",
  className,
);
---

{
  href ? (
    <a
      href={href}
      class={baseClass}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={ariaLabel}
    >
      {(title || meta) && (
        <header class="mb-5 flex items-baseline justify-between gap-3">
          {title && <CardLabel label={title} />}
          {meta && <CardLabel label={meta} />}
        </header>
      )}
      <div class="flex flex-1 flex-col">
        <slot />
      </div>
    </a>
  ) : (
    <article class={baseClass}>
      {(title || meta) && (
        <header class="mb-5 flex items-baseline justify-between gap-3">
          {title && <CardLabel label={title} />}
          {meta && <CardLabel label={meta} />}
        </header>
      )}
      <div class="flex flex-1 flex-col">
        <slot />
      </div>
    </article>
  )
}
