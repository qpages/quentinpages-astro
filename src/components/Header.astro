---
import { site } from "../data/site";
import { buildNavLinks } from "../lib/site-links";
import NavLinks from "./NavLinks.astro";

const navLinks = buildNavLinks(site.links);
const menuId = "mobile-nav";
---

<header class="relative py-8 md:py-10" transition:persist="site-header">
  <div class="flex items-center justify-end gap-5 sm:justify-between">
    <nav class="hidden items-center gap-5 sm:flex" aria-label="Main navigation">
      <NavLinks links={navLinks} />
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="inline-flex size-11 items-center justify-center rounded-full bg-surface text-text-primary shadow-[var(--shadow-menu)] transition-transform hover:scale-[1.02] active:scale-[0.98] sm:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls={menuId}
    >
      <svg
        class="menu-icon-open"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="4" x2="20" y1="8" y2="8"></line>
        <line x1="4" x2="20" y1="16" y2="16"></line>
      </svg>
      <svg
        class="menu-icon-close hidden"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="18" x2="6" y1="6" y2="18"></line>
        <line x1="6" x2="18" y1="6" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav
    id={menuId}
    class="mobile-nav hidden border-t border-border/40 pt-4 sm:hidden"
    aria-label="Mobile navigation"
    hidden
  >
    <NavLinks links={navLinks} variant="mobile" />
  </nav>
</header>

<script>
  let mobileNavController: AbortController | undefined;

  function setupMobileNav() {
    mobileNavController?.abort();
    mobileNavController = new AbortController();
    const { signal } = mobileNavController;

    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-nav");
    const iconOpen = toggle?.querySelector(".menu-icon-open");
    const iconClose = toggle?.querySelector(".menu-icon-close");

    if (!toggle || !menu || !iconOpen || !iconClose) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.hidden = !open;
      menu.classList.toggle("hidden", !open);
      iconOpen.classList.toggle("hidden", open);
      iconClose.classList.toggle("hidden", !open);
    };

    toggle.addEventListener(
      "click",
      () => setOpen(toggle.getAttribute("aria-expanded") !== "true"),
      { signal },
    );

    menu.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => setOpen(false), { signal });
    });

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") setOpen(false);
      },
      { signal },
    );
  }

  setupMobileNav();
  document.addEventListener("astro:page-load", setupMobileNav);
</script>
