---
import type { NavLink } from "../types/site";
import { isCurrentNavLink } from "../lib/site-links";

interface Props {
  links: NavLink[];
  variant?: "horizontal" | "mobile";
  currentPath?: string;
}

const { links, variant = "horizontal", currentPath } = Astro.props;

const linkClass =
  variant === "mobile"
    ? "mobile-nav-link flex min-h-11 items-center rounded-md px-1 text-base text-text-secondary transition-colors hover:bg-surface/60 hover:text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-primary aria-[current=page]:text-text-primary"
    : "inline-flex min-h-11 items-center rounded-md px-1 text-sm text-text-secondary transition-colors hover:text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-primary aria-[current=page]:text-text-primary";
---

{
  variant === "mobile" ? (
    <ul class="flex flex-col gap-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class={linkClass}
            data-nav
            {...(link.external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
            {...(currentPath && isCurrentNavLink(link.href, currentPath)
              ? { "aria-current": "page" as const }
              : {})}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    links.map((link) => (
      <a
        href={link.href}
        class={linkClass}
        data-nav
        {...(link.external
          ? { target: "_blank", rel: "noopener noreferrer" }
          : {})}
        {...(currentPath && isCurrentNavLink(link.href, currentPath)
          ? { "aria-current": "page" as const }
          : {})}
      >
        {link.label}
      </a>
    ))
  )
}
