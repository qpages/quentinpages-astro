---
import Button from "./Button.astro";
import SocialLinks from "./SocialLinks.astro";
import { getFullName, getTaglineParts } from "../lib/profile";
import type { SiteCta, SiteProfile, SocialLink } from "../types/site";

interface Props {
  profile: SiteProfile;
  cta: SiteCta;
  ctaSecondary: SiteCta;
  social: SocialLink[];
}

const { profile, cta, ctaSecondary, social } = Astro.props;

const fullName = getFullName(profile);
const taglineParts = getTaglineParts(profile.tagline, profile.taglineHighlight);
const avatarSrc = profile.photo ?? "/images/avatar.webp";
const updatedAt = profile.updatedAt
  ? new Date(`${profile.updatedAt}T00:00:00Z`)
  : null;
const daysSinceUpdate = updatedAt
  ? Math.max(0, Math.floor((Date.now() - updatedAt.getTime()) / 86_400_000))
  : null;

const avatarClass = "size-full scale-125 object-cover";
---

<aside
  class="mb-10 lg:sticky lg:top-8 lg:mb-0 lg:w-56 lg:shrink-0 xl:w-60"
  aria-label="Profile"
>
  <div class="reveal flex items-start gap-4 lg:block">
    <div
      class="size-14 shrink-0 overflow-hidden rounded-2xl ring-1 ring-border/60 shadow-[var(--shadow-card)] lg:size-16"
    >
      <img
        src={avatarSrc}
        alt={`Photo of ${fullName}`}
        width="80"
        height="80"
        class={avatarClass}
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="min-w-0 pt-0.5 lg:mt-6">
      <h1
        class="text-lg font-semibold tracking-tight text-text-primary lg:text-xl"
      >
        {profile.firstName}{" "}{profile.lastName}
      </h1>
      <p class="mt-1 text-sm leading-snug text-text-secondary">
        {profile.role}
        {profile.company && <> at {profile.company}</>}
      </p>
    </div>
  </div>

  <p
    class="reveal reveal-delay-2 mt-7 text-sm leading-relaxed text-text-secondary lg:mt-9 lg:reveal-delay-3"
  >
    {
      taglineParts.map((part) =>
        part.highlight ? (
          <span class="font-accent text-text-primary">{part.text}</span>
        ) : (
          part.text
        ),
      )
    }
  </p>

  {
    social.length > 0 && (
      <nav
        aria-label="Social links"
        class="reveal reveal-delay-3 mt-6 lg:reveal-delay-3"
      >
        <SocialLinks links={social} compact />
      </nav>
    )
  }

  <div class="reveal reveal-delay-3 mt-7 lg:reveal-delay-3">
    <div class="flex flex-wrap gap-2.5">
      <Button href={cta.href} pulse size="compact">{cta.label}</Button>
      <Button href={ctaSecondary.href} variant="secondary" size="compact">
        {ctaSecondary.label}
      </Button>
    </div>
  </div>

  {
    updatedAt && daysSinceUpdate !== null && (
      <p class="reveal reveal-delay-3 mt-5 font-mono text-[0.625rem] tracking-tight text-text-muted">
        {daysSinceUpdate === 0
          ? "Mis à jour aujourd’hui."
          : `Mis à jour il y a ${daysSinceUpdate} jour${daysSinceUpdate === 1 ? "" : "s"}.`}
      </p>
    )
  }
</aside>
