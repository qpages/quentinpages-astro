---
import Button from "./Button.astro";
import SocialLinks from "./SocialLinks.astro";
import { getMainUpdatedAt } from "../lib/main-updated-at";
import { getFullName, getTaglineParts } from "../lib/profile";
import { formatUpdatedLabel } from "../lib/updated-label";
import type { SiteCta, SiteProfile, SocialLink } from "../types/site";

interface Props {
  profile: SiteProfile;
  cta: SiteCta;
  ctaSecondary: SiteCta;
  social: SocialLink[];
}

const { profile, cta, ctaSecondary, social } = Astro.props;

const fullName = getFullName(profile);
const taglineParts = getTaglineParts(profile.tagline, profile.taglineHighlight);
const avatarSrc = profile.photo ?? "/images/avatar.webp";
const updatedAt = await getMainUpdatedAt();
const updatedLabel = updatedAt ? formatUpdatedLabel(updatedAt) : null;

const avatarClass = "size-full scale-125 object-cover";
---

<aside
  class="mb-10 sm:mb-12 lg:sticky lg:top-8 lg:mb-0 lg:w-64 lg:shrink-0 xl:w-72"
  aria-label="Profile"
>
  <div class="reveal flex items-center gap-4 sm:gap-5 lg:block">
    <div
      class="size-20 shrink-0 overflow-hidden rounded-2xl ring-1 ring-border/60 shadow-[var(--shadow-card)]"
    >
      <img
        src={avatarSrc}
        alt={`Photo of ${fullName}`}
        width="96"
        height="96"
        class={avatarClass}
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="min-w-0 lg:mt-7">
      <h1 class="text-2xl font-semibold tracking-tight text-text-primary">
        {profile.firstName}{" "}{profile.lastName}
      </h1>
      <p class="mt-2 text-base leading-snug text-text-secondary">
        {profile.role}
        {profile.company && <> at {profile.company}</>}
      </p>
    </div>
  </div>

  <p
    class="reveal reveal-delay-2 mt-6 text-base leading-relaxed text-text-secondary sm:mt-8 lg:mt-10 lg:reveal-delay-3"
  >
    {
      taglineParts.map((part) =>
        part.highlight ? (
          <span class="font-accent text-text-primary">{part.text}</span>
        ) : (
          part.text
        ),
      )
    }
  </p>

  {
    social.length > 0 && (
      <nav
        aria-label="Social links"
        class="reveal reveal-delay-3 mt-6 sm:mt-7 lg:mt-6 lg:reveal-delay-3"
      >
        <SocialLinks links={social} />
      </nav>
    )
  }

  <div class="reveal reveal-delay-3 mt-7 lg:reveal-delay-3">
    <div
      class="grid grid-cols-1 gap-2.5 min-[22rem]:grid-cols-2 lg:flex lg:flex-row lg:flex-wrap lg:gap-3"
    >
      <Button
        href={cta.href}
        pulse
        class="min-h-11 w-full justify-center lg:w-fit"
      >
        {cta.label}
      </Button>
      <Button
        href={ctaSecondary.href}
        variant="secondary"
        class="min-h-11 w-full justify-center max-lg:border-border-subtle max-lg:bg-surface/35 lg:w-fit"
      >
        {ctaSecondary.label}
      </Button>
    </div>
  </div>

  {
    updatedAt && updatedLabel && (
      <p class="reveal reveal-delay-3 mt-5 font-mono text-xs tracking-tight text-text-muted lg:mt-6">
        <time id="site-updated-at" datetime={updatedAt.toISOString()}>
          {updatedLabel}
        </time>
      </p>
    )
  }
</aside>

<script>
  import { formatUpdatedLabel } from "../lib/updated-label";

  const el = document.getElementById("site-updated-at");
  if (el instanceof HTMLTimeElement && el.dateTime) {
    const date = new Date(el.dateTime);
    if (!Number.isNaN(date.getTime())) {
      el.textContent = formatUpdatedLabel(date);
    }
  }
</script>
