---
import { cn } from "../lib/cn";

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<span
  class={cn(
    "inline-flex w-fit items-center font-mono text-[0.6875rem] tracking-wide text-text-muted uppercase",
    className,
  )}
>
  {label}
</span>
