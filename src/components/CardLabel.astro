---
import { cn } from "../lib/cn";

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<span
  class={cn(
    "inline-flex w-fit items-center rounded-[var(--radius-pill)] bg-label-bg px-3.5 py-1.5 text-[0.8125rem] font-medium tracking-[-0.01em] text-label-text",
    className,
  )}
>
  {label}
</span>
