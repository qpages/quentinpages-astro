---
import Card from "../Card.astro";
import { site } from "../../data/site";
import { bentoSpanClasses, cn } from "../../lib/cn";
import {
  formatLocalTime,
  formatUtcOffset,
  getMapsUrl,
} from "../../lib/location";
import type { BentoCardConfig } from "../../types/site";

interface Props {
  card: BentoCardConfig;
  style?: string;
}

const { card, style } = Astro.props;

const { profile } = site;
const city = profile.city ?? profile.location;
const now = new Date();
const localTime = formatLocalTime(profile.timezone, now);
const utcOffset = formatUtcOffset(profile.timezone, now);
const mapsUrl = profile.mapCoordinates
  ? getMapsUrl(profile.mapCoordinates)
  : undefined;
const coordinates = profile.mapCoordinates
  ? `${profile.mapCoordinates.lat.toFixed(4)}° N · ${profile.mapCoordinates.lng.toFixed(4)}° E`
  : undefined;
---

<div
  class={cn(
    "reveal h-full",
    bentoSpanClasses(card.colSpan, card.rowSpan, card.minHeight),
  )}
  style={style}
>
  <Card
    title={card.title}
    href={mapsUrl}
    ariaLabel={mapsUrl ? `Open ${city} on Google Maps` : undefined}
    class="location-card h-full"
  >
    <div class="location-visual">
      {
        profile.locationPhoto && (
          <img
            src={profile.locationPhoto}
            alt=""
            width="1005"
            height="1440"
            loading="eager"
            decoding="async"
            class="location-photo"
          />
        )
      }

      <div class="location-shade" aria-hidden="true"></div>

      <div class="location-topline">
        <span class="location-city">{city}</span>
        {coordinates && <span class="coordinates">{coordinates}</span>}
      </div>

      <svg
        class="location-route"
        viewBox="0 0 360 180"
        fill="none"
        aria-hidden="true"
        preserveAspectRatio="none"
      >
        <path
          class="route-shadow"
          d="M-18 155C35 131 60 150 94 114C125 82 151 103 178 75C208 43 243 60 274 34C300 12 333 22 379 -6"
        ></path>
        <path
          class="route-line"
          d="M-18 155C35 131 60 150 94 114C125 82 151 103 178 75C208 43 243 60 274 34C300 12 333 22 379 -6"
        ></path>
      </svg>

      <div class="location-copy">
        <div class="location-meta">
          {
            profile.remoteFriendly && (
              <p class="availability">Working worldwide</p>
            )
          }
          <p class="local-time">
            <time
              datetime={now.toISOString()}
              data-local-time
              data-timezone={profile.timezone}
            >
              {localTime}
            </time>
            <small aria-hidden="true">{utcOffset}</small>
          </p>
        </div>
      </div>
    </div>
  </Card>
</div>

<script>
  function updateLocalTimes() {
    for (const el of document.querySelectorAll("[data-local-time]")) {
      if (!(el instanceof HTMLTimeElement)) continue;

      const timezone = el.dataset.timezone;
      if (!timezone) continue;

      const now = new Date();
      el.textContent = new Intl.DateTimeFormat("en-GB", {
        timeZone: timezone,
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }).format(now);
      el.dateTime = now.toISOString();
    }
  }

  updateLocalTimes();
  const intervalId = window.setInterval(updateLocalTimes, 30_000);

  document.addEventListener("astro:page-load", updateLocalTimes);
  document.addEventListener("astro:before-swap", () => {
    window.clearInterval(intervalId);
  });
</script>

<style>
  .location-visual {
    position: relative;
    min-height: 0;
    flex: 1;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    border-radius: 0.85rem;
    background: var(--color-surface);
    isolation: isolate;
  }

  .location-photo {
    position: absolute;
    z-index: -3;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
    filter: grayscale(0.82) sepia(0.12) saturate(0.7) contrast(1.12);
    transform: scale(1.015);
    transition:
      filter 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .location-shade {
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(115deg, rgb(7 8 10 / 0.18), rgb(7 8 10 / 0.48)),
      linear-gradient(180deg, rgb(9 9 11 / 0.38) 0%, transparent 38%),
      linear-gradient(
        0deg,
        rgb(9 9 11 / 0.82) 0%,
        rgb(9 9 11 / 0.28) 32%,
        transparent 58%
      );
  }

  .location-shade::after {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.22'/%3E%3C/svg%3E");
    content: "";
    mix-blend-mode: soft-light;
    opacity: 0.45;
  }

  .location-topline {
    position: absolute;
    top: 0.85rem;
    right: 0.9rem;
    left: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .location-city {
    color: var(--color-text-primary);
    font-family: var(--font-accent);
    font-size: 1.1rem;
    font-style: italic;
    letter-spacing: -0.04em;
    line-height: 1;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.35);
  }

  .coordinates {
    color: rgb(250 250 250 / 0.72);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .location-route {
    position: absolute;
    inset: 18% -4% auto;
    width: 108%;
    height: 52%;
    opacity: 0.72;
    pointer-events: none;
  }

  .route-shadow,
  .route-line {
    vector-effect: non-scaling-stroke;
  }

  .route-shadow {
    stroke: rgb(0 0 0 / 0.32);
    stroke-width: 4;
  }

  .route-line {
    stroke: rgb(255 255 255 / 0.72);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .location-copy {
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1rem;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: rgb(250 250 250 / 0.76);
    font-size: 0.64rem;
  }

  .location-meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    color: rgb(250 250 250 / 0.58);
  }

  .local-time {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    column-gap: 0.35rem;
    color: rgb(250 250 250 / 0.88);
    font-family: var(--font-mono);
    text-align: right;
  }

  .local-time time {
    font-size: 0.9rem;
    letter-spacing: -0.04em;
  }

  .local-time small {
    color: rgb(250 250 250 / 0.46);
    font-size: 0.47rem;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.location-card:hover) .location-photo {
      filter: grayscale(0.15) saturate(0.85) contrast(1);
      transform: scale(1.055);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .location-photo {
      transition: none;
    }
  }
</style>
