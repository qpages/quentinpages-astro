---
import Card from "../Card.astro";
import { getFeaturedCaseStudies } from "../../data/case-studies";
import { bentoSpanClasses, cn } from "../../lib/cn";
import type { BentoCardConfig } from "../../types/site";

interface Props {
  card: BentoCardConfig;
  style?: string;
}

const { card, style } = Astro.props;
const projects = getFeaturedCaseStudies().slice(0, 4);
---

<div
  class={cn(
    "reveal h-full",
    bentoSpanClasses(card.colSpan, card.rowSpan, card.minHeight),
  )}
  style={style}
  id="featured-work"
>
  <Card title={card.title} class="h-full">
    <div class="flex flex-1 flex-col gap-[var(--space-card-content)]">
      <p class="max-w-xl text-xl leading-snug tracking-tight text-text-muted">
        Recent work, from{" "}
        <span class="font-accent text-text-secondary"
          >problem to production.</span
        >
      </p>

      <ul class="project-list" aria-label="Featured projects">
        {
          projects.map((project) => (
            <li class="project-item">
              <a href={project.caseStudyUrl ?? "#"} class="project-link group">
                <div class="project-body min-w-0 flex-1">
                  <p class="text-[0.9375rem] font-semibold tracking-[-0.01em] text-text-primary transition-colors group-hover:text-text-secondary">
                    {project.title}
                  </p>
                  <p class="text-xs text-text-muted">
                    {project.client}
                    <span aria-hidden="true"> · </span>
                    {project.year}
                  </p>
                  <p class="text-sm leading-relaxed text-text-secondary">
                    {project.teaser}
                  </p>
                  <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
                    {project.stack.slice(0, 4).map((tech) => (
                      <li class="project-tag">{tech}</li>
                    ))}
                  </ul>
                </div>
                <span class="project-cta shrink-0">
                  View case study
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Card>
</div>

<style>
  .project-item {
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 34%, transparent);
  }

  .project-item:last-child {
    border-bottom: none;
  }

  .project-link {
    display: flex;
    min-height: 2.75rem;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-item);
    padding-block: 0.25rem 0;
    color: inherit;
    text-decoration: none;
    outline: none;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
  }

  .project-body > :nth-child(n + 3) {
    margin-top: 0.375rem;
  }

  @media (min-width: 40rem) {
    .project-link {
      flex-direction: row;
      align-items: flex-end;
      gap: 1.5rem;
      padding-block: 0.25rem;
    }
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-pill);
    border: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 50%, transparent);
  }

  /* Same treatment as CardCta, kept as a span because the row is already a link */
  .project-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding-block: 0.25rem;
    font-size: var(--text-xs);
    line-height: var(--text-xs--line-height);
    letter-spacing: 0.025em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    transition: color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-link:hover .project-cta,
    .project-link:focus-visible .project-cta {
      color: var(--color-text-primary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-cta {
      transition: none;
    }
  }
</style>
