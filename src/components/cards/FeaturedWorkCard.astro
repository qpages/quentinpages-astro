---
import Card from "../Card.astro";
import { getFeaturedCaseStudies } from "../../data/case-studies";
import { bentoSpanClasses, cn } from "../../lib/cn";
import type { BentoCardConfig } from "../../types/site";

interface Props {
  card: BentoCardConfig;
  style?: string;
}

const { card, style } = Astro.props;
const projects = getFeaturedCaseStudies().slice(0, 4);
---

<div
  class={cn(
    "reveal h-full",
    bentoSpanClasses(card.colSpan, card.rowSpan, card.minHeight),
  )}
  style={style}
  id="featured-work"
>
  <Card title={card.title} class="h-full">
    <div class="flex flex-1 flex-col gap-5">
      <p class="max-w-xl text-xl leading-snug tracking-tight text-text-muted">
        Recent work, from{" "}
        <span class="font-accent text-text-secondary"
          >problem to production.</span
        >
      </p>

      <ul class="project-list" aria-label="Featured projects">
        {
          projects.map((project) => (
            <li class="project-item">
              <a href={project.caseStudyUrl ?? "#"} class="project-link group">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <p class="text-[0.9375rem] font-semibold tracking-[-0.01em] text-text-primary transition-colors group-hover:text-text-secondary">
                      {project.title}
                    </p>
                    {project.highlight && (
                      <span class="project-metric shrink-0">
                        {project.highlight}
                      </span>
                    )}
                  </div>
                  <p class="mt-0.5 text-xs text-text-muted">
                    {project.client}
                    <span aria-hidden="true"> · </span>
                    {project.year}
                  </p>
                  <p class="mt-1.5 text-sm leading-relaxed text-text-secondary">
                    {project.teaser}
                  </p>
                  <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Stack">
                    {project.stack.slice(0, 4).map((tech) => (
                      <li class="project-tag">{tech}</li>
                    ))}
                  </ul>
                </div>
                <span class="project-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Card>
</div>

<style>
  .project-item {
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 34%, transparent);
  }

  .project-item:last-child {
    border-bottom: none;
  }

  .project-link {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-block: 1rem;
    color: inherit;
    text-decoration: none;
    outline: none;
  }

  .project-metric {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-status);
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-pill);
    border: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 50%, transparent);
  }

  .project-arrow {
    margin-top: 0.125rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-link:hover .project-arrow,
    .project-link:focus-visible .project-arrow {
      opacity: 1;
      transform: translateX(0);
      color: var(--color-text-secondary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-arrow {
      transition: none;
    }
  }
</style>
