---
import Card from "../Card.astro";
import { tools } from "../../data/tools";
import { bentoSpanClasses, cn } from "../../lib/cn";

interface Props {
  style?: string;
}

const { style } = Astro.props;
---

<div
  class={cn("reveal h-full", bentoSpanClasses(2, 1, "min-h-64"))}
  style={style}
  id="tools"
>
  <Card class="h-full">
    <div class="flex flex-1 flex-col gap-5">
      <p class="max-w-xl text-xl leading-snug tracking-tight text-text-muted">
        Small tools, from a recurring question to{" "}
        <span class="font-accent text-text-secondary"
          >something you can use.</span
        >
      </p>

      <ul class="tool-list" aria-label="Available tools">
        {
          tools.map((tool) => (
            <li class="tool-item">
              <a href={`/tools/${tool.slug}`} class="tool-link group">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <p class="text-[0.9375rem] font-semibold tracking-[-0.01em] text-text-primary transition-colors group-hover:text-text-secondary">
                      {tool.title}
                    </p>
                    {tool.highlight && (
                      <span class="tool-metric shrink-0">{tool.highlight}</span>
                    )}
                  </div>
                  <p class="mt-1.5 text-sm leading-relaxed text-text-secondary">
                    {tool.teaser}
                  </p>
                  <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Topics">
                    {tool.tags.map((tag) => (
                      <li class="tool-tag">{tag}</li>
                    ))}
                  </ul>
                </div>
                <span class="tool-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Card>
</div>

<style>
  .tool-item {
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 34%, transparent);
  }

  .tool-item:last-child {
    border-bottom: none;
  }

  .tool-link {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-block: 1rem;
    color: inherit;
    text-decoration: none;
    outline: none;
  }

  .tool-metric {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-status);
  }

  .tool-tag {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-pill);
    border: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 50%, transparent);
  }

  .tool-arrow {
    margin-top: 0.125rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .tool-link:hover .tool-arrow,
    .tool-link:focus-visible .tool-arrow {
      opacity: 1;
      transform: translateX(0);
      color: var(--color-text-secondary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-arrow {
      transition: none;
    }
  }
</style>
