---
import Card from "../Card.astro";
import CardCta from "../CardCta.astro";
import { bentoSpanClasses, cn } from "../../lib/cn";
import type { BentoCardConfig } from "../../types/site";

interface Props {
  card: BentoCardConfig;
  style?: string;
}

const { card, style } = Astro.props;

const tracks = [
  {
    title: "adore u",
    artist: "Fred again.. & Obongjayar",
    audio: "/audio/adore-u.mp3",
    url: "https://open.spotify.com/search/adore%20u%20Fred%20again",
  },
  {
    title: "places to be",
    artist: "Fred again.., Anderson .Paak & CHIKA",
    audio: "/audio/places-to-be.mp3",
    url: "https://open.spotify.com/search/places%20to%20be%20Fred%20again",
  },
  {
    title: "peace u need",
    artist: "Fred again.. & Joy Anonymous",
    audio: "/audio/peace-u-need.mp3",
    url: "https://open.spotify.com/search/peace%20u%20need%20Fred%20again",
  },
];

const spotifyUrl = "https://open.spotify.com/artist/4oLeXFyACqeem2VImYeBFe";
---

<div
  class={cn(
    "reveal h-full",
    bentoSpanClasses(card.colSpan, card.rowSpan, card.minHeight),
  )}
  style={style}
>
  <Card title={card.title} class="music-card h-full">
    <div class="music-layout">
      <div class="cover-wrap" aria-hidden="true">
        <div class="cover">
          <span class="cover__glow"></span>
          <span class="cover__type">again<br />again<br />again</span>
          <span class="cover__note">QP / 08.26</span>
        </div>
      </div>

      <div class="min-w-0 flex-1">
        <p class="mb-3 font-accent text-xl leading-none text-text-primary">
          Fred again..
        </p>

        <ol class="tracklist">
          {
            tracks.map((track, index) => (
              <li class="track">
                <button
                  type="button"
                  class="track__toggle"
                  data-audio={track.audio}
                  data-track-index={index}
                  aria-pressed="false"
                  aria-label={`Play ${track.title} by ${track.artist}`}
                >
                  <span class="track__index">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="track__control" aria-hidden="true">
                    <svg
                      class="track__icon track__icon--play"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l9.962 5.752c1.22.707 1.22 2.476 0 3.183l-9.962 5.752c-1.25.687-2.779-.217-2.779-1.643V5.653Z"
                      />
                    </svg>
                    <svg
                      class="track__icon track__icon--pause"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M5.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V3.75A.75.75 0 0 0 7.25 3h-1.5ZM12.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V3.75a.75.75 0 0 0-.75-.75h-1.5Z"
                      />
                    </svg>
                  </span>
                </button>

                <div class="track__meta">
                  <a
                    href={track.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="track__title"
                    aria-label={`Open ${track.title} on Spotify`}
                  >
                    {track.title}
                  </a>
                  <span class="track__artist">{track.artist}</span>
                </div>
              </li>
            ))
          }
        </ol>

        <CardCta href={spotifyUrl} external class="mt-[1.1rem]">
          Listen on Spotify
        </CardCta>
      </div>
    </div>
  </Card>
</div>

<script>
  function initMusicCard(card: HTMLElement) {
    const toggles = [
      ...card.querySelectorAll<HTMLButtonElement>("[data-audio]"),
    ];
    if (toggles.length === 0) return;

    const audio = new Audio();
    let activeIndex = -1;

    const setTrackState = (index: number, playing: boolean) => {
      for (const toggle of toggles) {
        const trackIndex = Number(toggle.dataset.trackIndex);
        const isActive = trackIndex === index;
        const track = toggle.closest(".track");

        toggle.setAttribute("aria-pressed", String(isActive && playing));
        toggle.setAttribute(
          "aria-label",
          isActive && playing
            ? `Pause ${toggle.closest(".track")?.querySelector(".track__title")?.textContent ?? "track"}`
            : `Play ${toggle.closest(".track")?.querySelector(".track__title")?.textContent ?? "track"}`,
        );

        track?.classList.toggle("is-active", isActive);
        track?.classList.toggle("is-playing", isActive && playing);
      }

      card.classList.toggle("is-playing", playing);
    };

    const playTrack = async (index: number) => {
      const toggle = toggles[index];
      const src = toggle?.dataset.audio;
      if (!toggle || !src) return;

      if (activeIndex === index && !audio.paused) {
        audio.pause();
        setTrackState(index, false);
        return;
      }

      if (activeIndex === index && audio.paused) {
        try {
          await audio.play();
          setTrackState(index, true);
        } catch {
          setTrackState(index, false);
        }
        return;
      }

      audio.pause();
      audio.src = src;
      activeIndex = index;

      try {
        await audio.play();
        setTrackState(index, true);
      } catch {
        setTrackState(index, false);
      }
    };

    for (const toggle of toggles) {
      toggle.addEventListener("click", () => {
        const index = Number(toggle.dataset.trackIndex);
        if (Number.isNaN(index)) return;
        void playTrack(index);
      });
    }

    audio.addEventListener("ended", () => {
      if (activeIndex >= 0) setTrackState(activeIndex, false);
    });

    audio.addEventListener("pause", () => {
      if (activeIndex >= 0 && !audio.ended) {
        setTrackState(activeIndex, false);
      }
    });

    const cleanup = () => {
      audio.pause();
      audio.src = "";
      setTrackState(activeIndex, false);
      activeIndex = -1;
    };

    document.addEventListener("astro:before-swap", cleanup, { once: true });
  }

  function initMusicCards() {
    for (const card of document.querySelectorAll<HTMLElement>(
      ".music-card:not([data-audio-init])",
    )) {
      card.dataset.audioInit = "true";
      initMusicCard(card);
    }
  }

  initMusicCards();
  document.addEventListener("astro:page-load", initMusicCards);
</script>

<style>
  .music-layout {
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr);
    flex: 1;
    gap: 1.35rem;
    align-items: center;
  }

  .cover-wrap {
    display: grid;
    place-items: center;
    perspective: 700px;
  }

  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    padding: 0.8rem;
    color: #1a100c;
    background:
      radial-gradient(circle at 72% 30%, #ffd2b7 0 8%, transparent 9%),
      linear-gradient(145deg, #ffb07c, #e86135 54%, #7f241c);
    border-radius: 0.25rem;
    box-shadow:
      -3px 4px 0 rgb(127 36 28 / 0.55),
      0 16px 30px rgb(0 0 0 / 0.32),
      0 0 0 1px rgb(255 255 255 / 0.08);
    transform: rotate(-2.5deg) rotateY(4deg);
    transform-origin: center center;
    transition:
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.55s ease;
  }

  .cover::after {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence baseFrequency='.72' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.32'/%3E%3C/svg%3E");
    content: "";
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .cover__glow {
    position: absolute;
    width: 5rem;
    height: 5rem;
    right: -1.25rem;
    bottom: -1rem;
    border: 1px solid rgb(255 229 208 / 0.45);
    border-radius: 50%;
    box-shadow:
      0 0 0 0.7rem rgb(255 210 180 / 0.09),
      0 0 0 1.5rem rgb(255 210 180 / 0.06);
  }

  .cover__type {
    position: relative;
    z-index: 1;
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 0.75;
    letter-spacing: -0.08em;
  }

  .cover__note {
    position: absolute;
    z-index: 1;
    bottom: 0.65rem;
    left: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.38rem;
    letter-spacing: 0.12em;
  }

  .tracklist {
    display: grid;
    gap: 0.7rem;
  }

  .track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.4rem;
    align-items: center;
  }

  .track__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 2.85rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .track__toggle:focus-visible {
    outline: 1px solid
      color-mix(in srgb, var(--color-text-primary) 45%, transparent);
    outline-offset: 2px;
    border-radius: 0.15rem;
  }

  .track__index {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    line-height: 1;
  }

  .track__control {
    position: relative;
    display: grid;
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
    place-items: center;
    border: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 42%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-text-primary) 3%, transparent);
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .track__icon {
    width: 0.575rem;
    height: 0.575rem;
    transition: opacity 0.2s ease;
  }

  .track__icon--play {
    margin-left: 0.04rem;
  }

  .track__icon--pause {
    position: absolute;
    inset: 0;
    margin: auto;
    display: none;
  }

  .track:hover .track__control,
  .track__toggle:focus-visible .track__control {
    border-color: color-mix(
      in srgb,
      var(--color-text-secondary) 34%,
      transparent
    );
    color: var(--color-text-primary);
  }

  .track.is-active .track__control {
    border-color: color-mix(in srgb, #ff9c67 38%, transparent);
    background: color-mix(in srgb, #ff9c67 9%, transparent);
    color: #ff9c67;
  }

  .track.is-playing .track__control {
    border-color: color-mix(in srgb, #ff9c67 58%, transparent);
    background: color-mix(in srgb, #ff9c67 14%, transparent);
  }

  .track.is-playing .track__icon--play {
    display: none;
  }

  .track.is-playing .track__icon--pause {
    display: block;
  }

  .track__meta {
    min-width: 0;
  }

  .track__title {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.76rem;
    line-height: 1.2;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .track__title:hover {
    color: #ff9c67;
    text-decoration-color: color-mix(in srgb, #ff9c67 45%, transparent);
  }

  .track__artist {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-top: 0.12rem;
    font-size: 0.58rem;
    color: var(--color-text-muted);
  }

  .track.is-active .track__title {
    color: #ff9c67;
  }

  .track.is-active .track__title:hover {
    color: #ffb889;
    text-decoration-color: color-mix(in srgb, #ffb889 55%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .music-card:hover .cover,
    .music-card.is-playing .cover {
      box-shadow:
        -1px 2px 0 rgb(127 36 28 / 0.45),
        0 20px 36px rgb(0 0 0 / 0.4),
        0 0 0 1px rgb(255 255 255 / 0.1);
      transform: rotate(-0.5deg) rotateY(0deg) translateY(-3px);
    }

    .track__toggle:hover .track__control,
    .track.is-playing .track__control {
      transform: scale(1.04);
    }
  }

  @media (max-width: 639px) {
    .music-layout {
      grid-template-columns: 5.75rem minmax(0, 1fr);
      gap: 1rem;
    }

    .track__index {
      display: none;
    }

    .track__toggle {
      gap: 0;
      min-width: auto;
    }

    .track__control {
      width: 2rem;
      height: 2rem;
    }

    .track__icon {
      width: 0.875rem;
      height: 0.875rem;
    }

    .track {
      gap: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover {
      transition: none;
    }
  }
</style>
