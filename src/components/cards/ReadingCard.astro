---
import Card from "../Card.astro";
import CardCta from "../CardCta.astro";
import ReadingProgress from "../ReadingProgress.astro";
import { currentRead, readingPage } from "../../data/reading";
import { bentoSpanClasses, cn } from "../../lib/cn";
import type { BentoCardConfig } from "../../types/site";

interface Props {
  card: BentoCardConfig;
  style?: string;
}

const { card, style } = Astro.props;
const book = currentRead;
const page = readingPage(book);
---

<div
  class={cn(
    "reveal h-full",
    bentoSpanClasses(card.colSpan, card.rowSpan, card.minHeight),
  )}
  style={style}
>
  <Card title={card.title} class="reading-card h-full">
    <div class="reading-layout">
      <div class="book-wrap">
        <img
          class="book"
          src={book.cover}
          alt={`Cover of ${book.title}`}
          width="448"
          height="625"
        />
      </div>

      <div class="flex min-w-0 flex-1 flex-col justify-between gap-4">
        <div>
          <h3 class="font-accent text-xl leading-[1.05] text-text-primary">
            {book.title}
          </h3>
          <p class="mt-1 text-xs text-text-secondary">
            {book.subtitle}, {book.author}
          </p>
        </div>

        <div>
          <ReadingProgress
            label={`Reading progress for ${book.title}`}
            progress={book.progress}
            currentPage={page}
            totalPages={book.pages}
          />
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
            <CardCta href={book.href} external>Read on Kindle</CardCta>
            <span class="text-border-subtle" aria-hidden="true">/</span>
            <CardCta href="/reading">Browse my bookshelf</CardCta>
          </div>
        </div>
      </div>
    </div>
  </Card>
</div>

<style>
  .reading-layout {
    display: flex;
    flex: 1;
    align-items: stretch;
    gap: 1.25rem;
  }

  .book-wrap {
    display: grid;
    width: 5.4rem;
    flex: none;
    place-items: center;
    perspective: 700px;
  }

  .book {
    width: 4.9rem;
    height: auto;
    aspect-ratio: 448 / 625;
    object-fit: cover;
    border-radius: 0.15rem 0.28rem 0.28rem 0.12rem;
    box-shadow: -8px 14px 24px rgb(0 0 0 / 0.34);
    transform: rotate(-3deg) rotateY(4deg);
    transform-origin: bottom center;
    transition:
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.55s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .reading-card:hover .book {
      box-shadow: -6px 16px 28px rgb(0 0 0 / 0.42);
      transform: rotate(-0.5deg) rotateY(0deg) translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book {
      transition: none;
    }
  }
</style>
