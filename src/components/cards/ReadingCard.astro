---
import Card from "../Card.astro";
import { bentoSpanClasses, cn } from "../../lib/cn";
import type { BentoCardConfig } from "../../types/site";

interface Props {
  card: BentoCardConfig;
  style?: string;
}

const { card, style } = Astro.props;

const book = {
  title: "The Creative Act",
  subtitle: "A Way of Being",
  author: "Rick Rubin",
  progress: 46,
  currentPage: 148,
  totalPages: 320,
  kindleUrl:
    "https://www.amazon.com/Creative-Act-Way-Being-ebook/dp/B09Z7MH5C3",
};
---

<div
  class={cn(
    "reveal h-full",
    bentoSpanClasses(card.colSpan, card.rowSpan, card.minHeight),
  )}
  style={style}
>
  <Card title={card.title} class="reading-card h-full">
    <div class="reading-layout">
      <div class="book-wrap" aria-hidden="true">
        <div class="book">
          <span class="book__title">THE<br />CREATIVE<br />ACT</span>
          <span class="book__subtitle">A WAY OF BEING</span>
          <span class="book__author">RICK RUBIN</span>
        </div>
      </div>

      <div class="flex min-w-0 flex-1 flex-col justify-between gap-4">
        <div>
          <h3 class="font-accent text-xl leading-[1.05] text-text-primary">
            {book.title}
          </h3>
          <p class="mt-1 text-xs text-text-secondary">
            {book.subtitle} · {book.author}
          </p>
        </div>

        <div>
          <div
            class="mb-2 flex items-center justify-between font-mono text-[0.625rem] text-text-muted"
          >
            <span>{book.currentPage} / {book.totalPages}</span>
            <span>{book.progress}%</span>
          </div>
          <div
            class="progress"
            role="progressbar"
            aria-label={`Reading progress for ${book.title}`}
            aria-valuenow={book.progress}
            aria-valuemin="0"
            aria-valuemax="100"
          >
            <span style={`--progress: ${book.progress}%`}></span>
          </div>
          <div
            class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs tracking-wide text-text-muted uppercase"
          >
            <a
              href={book.kindleUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-link inline-flex items-center gap-1"
            >
              Read on Kindle <span aria-hidden="true">→</span>
            </a>
            <span class="text-border-subtle" aria-hidden="true">/</span>
            <a href="/reading" class="text-link inline-flex items-center gap-1">
              Browse my bookshelf <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Card>
</div>

<style>
  .reading-layout {
    display: flex;
    flex: 1;
    align-items: stretch;
    gap: 1.25rem;
  }

  .book-wrap {
    display: grid;
    width: 5.4rem;
    flex: none;
    place-items: center;
    perspective: 700px;
  }

  .book {
    position: relative;
    display: flex;
    width: 4.9rem;
    height: 7.15rem;
    flex-direction: column;
    overflow: hidden;
    padding: 0.65rem 0.55rem 0.55rem;
    color: #16130c;
    background: #e9d634;
    border-radius: 0.15rem 0.3rem 0.3rem 0.15rem;
    box-shadow:
      -4px 5px 0 #8f8120,
      -8px 12px 24px rgb(0 0 0 / 0.34);
    transform: rotate(-3deg) rotateY(4deg);
    transform-origin: bottom center;
    transition:
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.55s ease;
  }

  .book::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.32'/%3E%3C/svg%3E");
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .book__title {
    font-family: var(--font-sans);
    font-size: 0.67rem;
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .book__subtitle {
    margin-top: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.23rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .book__author {
    margin-top: auto;
    font-family: var(--font-sans);
    font-size: 0.32rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .progress {
    height: 1px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-border-subtle) 60%, transparent);
  }

  .progress span {
    display: block;
    width: var(--progress);
    height: 100%;
    background: var(--color-text-primary);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .reading-card:hover .book {
      box-shadow:
        -2px 3px 0 #8f8120,
        -6px 16px 28px rgb(0 0 0 / 0.42);
      transform: rotate(-0.5deg) rotateY(0deg) translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book,
    .progress span {
      transition: none;
    }
  }
</style>
