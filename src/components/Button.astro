---
import { cn } from "../lib/cn";

type Variant = "primary" | "secondary";
type Size = "default" | "compact";

interface Props {
  href: string;
  variant?: Variant;
  size?: Size;
  pulse?: boolean;
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "default",
  pulse = false,
  external = false,
  class: className,
  ariaLabel,
} = Astro.props;

const variants: Record<Variant, string> = {
  primary:
    "bg-text-primary text-background hover:opacity-90 border-transparent",
  secondary:
    "bg-transparent text-text-primary border-border hover:bg-surface-hover",
};

const sizes: Record<Size, string> = {
  default: "px-5 py-2.5 text-sm font-medium",
  compact: "px-3.5 py-1.5 text-[0.8125rem] font-medium tracking-[-0.01em]",
};
---

<a
  href={href}
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  {...ariaLabel ? { "aria-label": ariaLabel } : {}}
  class={cn(
    "inline-flex min-h-11 w-fit items-center justify-center gap-1.5 rounded-[var(--radius-pill)] border focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-primary",
    sizes[size],
    pulse ? "cta-pulse" : "transition-opacity",
    variants[variant],
    className,
  )}
>
  <slot />
</a>
