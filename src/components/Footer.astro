---
import Button from "./Button.astro";

interface Props {
  name: string;
  email: string;
  github?: string;
}

const { name, email, github } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class="reveal mt-[var(--space-section)] border-t border-border/30 py-6 sm:py-8"
>
  <div
    class="flex flex-col gap-5 rounded-[var(--radius-card)] border border-border/30 bg-surface/35 p-[var(--space-card)] sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <p class="mb-2 font-mono text-xs tracking-wide text-text-muted uppercase">
        Let’s talk
      </p>
      <p class="max-w-md text-sm leading-relaxed text-text-secondary">
        Always curious to meet new people and hear what they’re building.
      </p>
    </div>
    <Button
      href={`mailto:${email}`}
      variant="secondary"
      ariaLabel={`Email ${name}`}
    >
      Say hello
    </Button>
  </div>

  <div
    class="mt-6 flex flex-col gap-3 text-sm text-text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {name}</p>
    <div class="flex items-center gap-5">
      {
        github && (
          <a
            href={github}
            class="inline-flex min-h-11 min-w-11 items-center justify-center px-1.5 transition-colors hover:text-text-secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        )
      }
      <a
        href="#"
        class="inline-flex min-h-11 min-w-11 items-center justify-center px-1.5 transition-colors hover:text-text-secondary"
        aria-label="Back to top">Top ↑</a
      >
    </div>
  </div>
</footer>
