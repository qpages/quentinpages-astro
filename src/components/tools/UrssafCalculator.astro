---
import {
  DEFAULT_AMOUNT,
  DEFAULT_MODE,
  DEFAULT_STATUS_ID,
  formatAmountInput,
  formatEuro,
  formatPercent,
  getStatus,
  netCaption,
  netShare,
  simulate,
  URSSAF_YEAR,
  urssafAssumptions,
  urssafCopy,
  urssafStatuses,
} from "../../data/tools/urssaf";

const initialStatus = getStatus(DEFAULT_STATUS_ID);
const initial = simulate({
  mode: DEFAULT_MODE,
  amount: DEFAULT_AMOUNT,
  statusId: DEFAULT_STATUS_ID,
  withVersementLiberatoire: false,
});

if (!initial) {
  throw new Error("Default URSSAF simulation must resolve.");
}

const initialNetShare = netShare(initial.rate) * 100;
const initialNetLabel = netCaption(DEFAULT_STATUS_ID, false);
---

<div class="tool" data-urssaf>
  <form class="instrument" data-instrument>
    <div class="instrument-top">
      <fieldset class="mode-fieldset">
        <legend class="sr-only">{urssafCopy.modeLegend}</legend>
        <div class="mode-track" role="presentation">
          <label class="mode-option">
            <input
              type="radio"
              name="mode"
              value="net-to-brut"
              checked
              data-mode
            />
            <span>{urssafCopy.modeNetToBrut}</span>
          </label>
          <label class="mode-option">
            <input type="radio" name="mode" value="brut-to-net" data-mode />
            <span>{urssafCopy.modeBrutToNet}</span>
          </label>
        </div>
      </fieldset>
    </div>

    <fieldset class="status-fieldset">
      <legend class="sr-only">{urssafCopy.statusLegend}</legend>
      <div class="status-rail">
        {
          urssafStatuses.map((status) => (
            <label class="status-chip">
              <input
                type="radio"
                name="status"
                value={status.id}
                checked={status.id === DEFAULT_STATUS_ID}
                data-status
              />
              <span>{status.shortLabel}</span>
            </label>
          ))
        }
        <label class="vl-chip" data-vl-wrap>
          <input type="checkbox" name="versement" data-vl />
          <span>{urssafCopy.versementLiberatoire}</span>
        </label>
      </div>
      <p class="status-note">
        <span data-status-copy>{initialStatus.description}</span>
        <span class="status-rate" data-status-rate
          >{formatPercent(initial.rate)}</span
        >
      </p>
    </fieldset>

    <div class="stage">
      <div class="clause clause-in">
        <p class="clause-lead" data-input-lead>
          {urssafCopy.inputLead["net-to-brut"]}
        </p>
        <div class="amount-row">
          <label class="sr-only" for="urssaf-amount"
            >{urssafCopy.amountLabel}</label
          >
          <input
            id="urssaf-amount"
            class="amount-input"
            name="amount"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="done"
            value={formatAmountInput(DEFAULT_AMOUNT)}
            data-amount
          />
          <span class="amount-currency" aria-hidden="true">€</span>
        </div>
        <p class="clause-meta" data-input-meta>{initialNetLabel}</p>
      </div>

      <div class="clause clause-out" aria-live="polite">
        <p class="clause-lead clause-lead-out" data-output-lead>
          {urssafCopy.outputLead["net-to-brut"]}
        </p>
        <p class="result-figure">
          <span data-output-value>{formatAmountInput(initial.output)}</span>
          <span class="amount-currency">€</span>
        </p>
        <p class="clause-meta" data-output-meta>{urssafCopy.brut}</p>
      </div>
    </div>

    <div class="split" data-split>
      <div
        class="split-track"
        style={`--net-share: ${initialNetShare}%;`}
        data-split-track
      >
        <span class="split-net"></span>
        <span class="split-charges"></span>
      </div>
      <div class="split-legend">
        <p>
          <span class="legend-net" data-net-value
            >{formatEuro(initial.net)}</span
          >
          <span data-net-caption> {initialNetLabel}</span>
        </p>
        <p>
          <span data-charges-value>{formatEuro(initial.contributions)}</span>
          <span data-charges-caption>{urssafCopy.contributions}</span>
        </p>
      </div>
    </div>

    <p class="ceiling" data-ceiling hidden>
      {urssafCopy.ceilingShort}
    </p>
  </form>

  <details class="assumptions">
    <summary>
      <span class="assumptions-toggle">
        <span class="assumptions-toggle-copy">
          {urssafCopy.assumptionsSummary}
        </span>
        <span class="assumptions-year">{URSSAF_YEAR}</span>
        <svg
          class="assumptions-chevron"
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </span>
    </summary>
    <div class="assumptions-body">
      <ul class="rate-list">
        {
          urssafStatuses.map((status) => (
            <li class="rate-row">
              <div class="rate-head">
                <span class="rate-name">{status.shortLabel}</span>
                <span class="rate-meta">
                  <span class="rate-value">
                    {formatPercent(status.socialRate)}
                    {status.approximate ? urssafCopy.approximateSuffix : ""}
                  </span>
                  {status.versementLiberatoireRate && (
                    <span class="rate-vl">
                      VL +{formatPercent(status.versementLiberatoireRate)}
                    </span>
                  )}
                </span>
              </div>
              {status.approximationNote && (
                <p class="rate-note">{status.approximationNote}</p>
              )}
            </li>
          ))
        }
      </ul>

      <div class="scope-grid">
        <section>
          <p class="assumptions-label">{urssafCopy.included}</p>
          <ul class="scope-list">
            {urssafAssumptions.included.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section>
          <p class="assumptions-label">{urssafCopy.excluded}</p>
          <ul class="scope-list">
            {urssafAssumptions.excluded.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>

      <div class="source-row">
        <p class="assumptions-label">{urssafCopy.sources}</p>
        <ul class="source-list">
          {
            urssafAssumptions.sources.map((source) => (
              <li>
                <a
                  href={source.href}
                  class="source-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="source-name">{source.label}</span>
                  <span class="source-detail">{source.detail}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </details>

  <p class="disclaimer">
    {urssafCopy.disclaimer}
  </p>
</div>

<style>
  .tool {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .instrument {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin: 0;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 30%, transparent);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-surface) 35%, transparent);
  }

  @media (min-width: 768px) {
    .instrument {
      gap: 2.25rem;
      padding: 2rem 2.25rem 2.25rem;
    }
  }

  .instrument-top {
    display: flex;
    justify-content: flex-start;
  }

  .mode-fieldset,
  .status-fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mode-track {
    display: inline-flex;
    width: 100%;
    padding: 0.2rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }

  @media (min-width: 640px) {
    .mode-track {
      width: auto;
    }
  }

  .mode-option {
    flex: 1;
    cursor: pointer;
  }

  .mode-option span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .mode-option:hover span {
    color: var(--color-text-primary);
  }

  .mode-option:has(:checked) span {
    background: var(--color-text-primary);
    color: var(--color-background);
  }

  .mode-option:focus-within span {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .mode-option input,
  .status-chip input,
  .vl-chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .status-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .status-chip,
  .vl-chip {
    cursor: pointer;
  }

  .status-chip span,
  .vl-chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    letter-spacing: -0.01em;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .status-chip:hover span,
  .vl-chip:hover span {
    border-color: var(--color-border-subtle);
    color: var(--color-text-primary);
  }

  .status-chip:has(:checked) span {
    border-color: transparent;
    background: var(--color-text-primary);
    color: var(--color-background);
  }

  .vl-chip:has(:checked) span {
    border-color: color-mix(in srgb, var(--color-status) 55%, transparent);
    color: var(--color-status);
  }

  .status-chip:focus-within span,
  .vl-chip:focus-within span {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .vl-chip:has(:disabled) {
    cursor: not-allowed;
  }

  .vl-chip:has(:disabled) span,
  .vl-chip:has(:disabled):hover span {
    border-color: color-mix(in srgb, var(--color-border) 40%, transparent);
    color: var(--color-text-muted);
    opacity: 0.45;
  }

  .vl-chip:has(:disabled):focus-within span {
    outline: none;
  }

  .status-note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem 1rem;
    margin: 0.85rem 0 0;
    max-width: 42rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .status-rate {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-status);
  }

  .stage {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  @media (min-width: 768px) {
    .stage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 3rem;
    }
  }

  .clause {
    min-width: 0;
  }

  .clause-lead {
    margin: 0 0 0.35rem;
    color: var(--color-text-secondary);
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .clause-lead-out {
    font-family: var(--font-accent);
    font-style: italic;
    color: var(--color-text-primary);
  }

  .amount-row {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    min-width: 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 55%, transparent);
  }

  .amount-input {
    field-sizing: content;
    min-width: 4ch;
    max-width: 100%;
    margin: 0;
    padding: 0.1rem 0 0.35rem;
    border: 0;
    background: transparent;
    color: var(--color-text-primary);
    font: inherit;
    font-size: 3rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1;
    caret-color: var(--color-text-primary);
  }

  .amount-input:focus {
    outline: none;
  }

  .amount-row:focus-within {
    border-bottom-color: var(--color-text-primary);
  }

  .amount-currency {
    color: var(--color-text-muted);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .result-figure {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    margin: 0;
    color: var(--color-text-primary);
    font-size: 3rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .amount-input,
    .result-figure {
      font-size: 4.25rem;
    }

    .amount-currency {
      font-size: 1.5rem;
    }
  }

  .clause-meta {
    margin: 0.7rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    letter-spacing: -0.01em;
  }

  .split-track {
    display: flex;
    overflow: hidden;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--color-border);
  }

  .split-net {
    width: var(--net-share);
    background: var(--color-status);
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .split-charges {
    flex: 1;
    background: color-mix(in srgb, var(--color-text-muted) 35%, transparent);
  }

  .split-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 0.85rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    letter-spacing: -0.01em;
  }

  .legend-net,
  .split-legend [data-charges-value] {
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .ceiling {
    margin: -0.5rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
  }

  .assumptions {
    interpolate-size: allow-keywords;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .assumptions::details-content {
    block-size: 0;
    overflow: clip;
    content-visibility: hidden;
    transition:
      block-size 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      content-visibility 0.4s allow-discrete;
  }

  .assumptions[open]::details-content {
    block-size: auto;
    content-visibility: visible;
  }

  .assumptions summary {
    cursor: pointer;
    list-style: none;
  }

  .assumptions summary::-webkit-details-marker {
    display: none;
  }

  .assumptions-toggle {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    padding: 0.2rem 0.65rem 0.2rem 1.05rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
    color: var(--color-text-secondary);
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .assumptions summary:hover .assumptions-toggle {
    border-color: var(--color-border-subtle);
    color: var(--color-text-primary);
  }

  .assumptions summary:focus-visible {
    outline: none;
  }

  .assumptions summary:focus-visible .assumptions-toggle {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .assumptions[open] .assumptions-toggle {
    border-color: color-mix(
      in srgb,
      var(--color-border-subtle) 70%,
      transparent
    );
    color: var(--color-text-primary);
  }

  .assumptions-toggle-copy {
    flex: 1;
    min-width: 0;
    font-size: 0.8125rem;
    letter-spacing: -0.01em;
  }

  .assumptions-year {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-status);
  }

  .assumptions-chevron {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .assumptions[open] .assumptions-chevron {
    transform: rotate(180deg);
    color: var(--color-text-secondary);
  }

  .assumptions-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.35rem 0.15rem 0.15rem;
  }

  .rate-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rate-row {
    padding: 0.85rem 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border-subtle) 34%, transparent);
  }

  .rate-row:first-child {
    padding-top: 0;
  }

  .rate-row:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .rate-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
  }

  .rate-name {
    color: var(--color-text-primary);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .rate-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.7rem;
  }

  .rate-value {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .rate-vl {
    padding: 0.12rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--color-status) 35%, transparent);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-status);
  }

  .rate-note {
    margin: 0.4rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .scope-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .scope-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 2rem;
    }
  }

  .assumptions-label {
    margin: 0 0 0.55rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .scope-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scope-list li {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .source-row {
    padding-top: 0.15rem;
  }

  .source-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .source-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.7rem;
    padding: 0.45rem 0;
    color: inherit;
    text-decoration: none;
    outline: none;
  }

  .source-name {
    color: var(--color-text-primary);
    font-size: 0.8125rem;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }

  .source-detail {
    flex: 1;
    min-width: 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .source-link span:last-child {
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.25s ease;
  }

  .source-link:hover .source-name,
  .source-link:focus-visible .source-name {
    color: var(--color-text-secondary);
  }

  @media (hover: hover) and (pointer: fine) {
    .source-link:hover span:last-child,
    .source-link:focus-visible span:last-child {
      opacity: 1;
      transform: translateX(0);
      color: var(--color-text-secondary);
    }
  }

  .disclaimer {
    max-width: 36rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .mode-option span,
    .status-chip span,
    .vl-chip span,
    .split-net,
    .assumptions-toggle,
    .assumptions-chevron,
    .source-name,
    .source-link span:last-child {
      transition: none;
    }

    .assumptions::details-content {
      transition: none;
    }
  }
</style>

<script>
  import {
    ceilingMessage,
    chargesCaption,
    formatAmountInput,
    formatEuro,
    formatPercent,
    getStatus,
    netCaption,
    netShare,
    parseAmount,
    simulate,
    supportsVersementLiberatoire,
    urssafCopy,
    type CalcMode,
    type StatusId,
  } from "../../data/tools/urssaf";

  let controller: AbortController | undefined;

  function setupCalculator() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const root = document.querySelector<HTMLElement>("[data-urssaf]");
    if (!root) return;

    const amountInput = root.querySelector<HTMLInputElement>("[data-amount]");
    const outputValue = root.querySelector("[data-output-value]");
    const inputLead = root.querySelector("[data-input-lead]");
    const outputLead = root.querySelector("[data-output-lead]");
    const inputMeta = root.querySelector("[data-input-meta]");
    const outputMeta = root.querySelector("[data-output-meta]");
    const statusCopy = root.querySelector("[data-status-copy]");
    const statusRate = root.querySelector("[data-status-rate]");
    const splitTrack = root.querySelector<HTMLElement>("[data-split-track]");
    const netValue = root.querySelector("[data-net-value]");
    const netCaptionEl = root.querySelector("[data-net-caption]");
    const chargesValue = root.querySelector("[data-charges-value]");
    const chargesCaptionEl = root.querySelector("[data-charges-caption]");
    const ceiling = root.querySelector<HTMLElement>("[data-ceiling]");
    const vlWrap = root.querySelector<HTMLElement>("[data-vl-wrap]");
    const vlInput = root.querySelector<HTMLInputElement>("[data-vl]");
    const form = root.querySelector<HTMLFormElement>("[data-instrument]");

    if (
      !amountInput ||
      !outputValue ||
      !inputLead ||
      !outputLead ||
      !inputMeta ||
      !outputMeta ||
      !statusCopy ||
      !statusRate ||
      !splitTrack ||
      !netValue ||
      !netCaptionEl ||
      !chargesValue ||
      !chargesCaptionEl ||
      !ceiling ||
      !vlWrap ||
      !vlInput ||
      !form
    ) {
      return;
    }

    const readMode = (): CalcMode => {
      const checked = root.querySelector<HTMLInputElement>(
        "[data-mode]:checked",
      );
      return checked?.value === "brut-to-net" ? "brut-to-net" : "net-to-brut";
    };

    const readStatus = (): StatusId => {
      const checked = root.querySelector<HTMLInputElement>(
        "[data-status]:checked",
      );
      const value = checked?.value;
      if (
        value === "micro-bnc" ||
        value === "micro-bic-services" ||
        value === "portage"
      ) {
        return value;
      }
      return "micro-bnc";
    };

    const render = (formatField: boolean) => {
      const mode = readMode();
      const statusId = readStatus();
      const status = getStatus(statusId);
      const vlAvailable = supportsVersementLiberatoire(status);
      const withVL = vlAvailable && vlInput.checked;
      const amount = parseAmount(amountInput.value);

      vlInput.disabled = !vlAvailable;
      vlWrap.setAttribute("aria-disabled", String(!vlAvailable));
      vlWrap.title = vlAvailable
        ? ""
        : urssafCopy.versementLiberatoireUnavailable;
      if (!vlAvailable) vlInput.checked = false;

      const caption = netCaption(statusId, withVL);
      inputLead.textContent = urssafCopy.inputLead[mode];
      outputLead.textContent = urssafCopy.outputLead[mode];
      inputMeta.textContent =
        mode === "net-to-brut" ? caption : urssafCopy.brut;
      outputMeta.textContent =
        mode === "net-to-brut" ? urssafCopy.brut : caption;

      const result =
        amount && amount > 0
          ? simulate({
              mode,
              amount,
              statusId,
              withVersementLiberatoire: withVL,
            })
          : null;

      const rate = result?.rate ?? status.socialRate;
      statusCopy.textContent = status.description;
      statusRate.textContent = formatPercent(rate);

      if (!result) {
        outputValue.textContent = "—";
        netValue.textContent = "—";
        chargesValue.textContent = "—";
        netCaptionEl.textContent = ` ${caption}`;
        chargesCaptionEl.textContent = chargesCaption(statusId);
        splitTrack.style.setProperty("--net-share", `${netShare(rate) * 100}%`);
        ceiling.hidden = true;
        return;
      }

      if (formatField && document.activeElement !== amountInput) {
        amountInput.value = formatAmountInput(amount ?? result.amount);
      }

      outputValue.textContent = formatAmountInput(result.output);
      netValue.textContent = formatEuro(result.net);
      chargesValue.textContent = formatEuro(result.contributions);
      netCaptionEl.textContent = ` ${caption}`;
      chargesCaptionEl.textContent = chargesCaption(statusId);
      splitTrack.style.setProperty(
        "--net-share",
        `${netShare(result.rate) * 100}%`,
      );

      if (result.overCeiling && status.ceiling) {
        ceiling.hidden = false;
        ceiling.textContent = ceilingMessage(status.ceiling);
      } else {
        ceiling.hidden = true;
      }
    };

    form.addEventListener("submit", (event) => event.preventDefault(), {
      signal,
    });

    amountInput.addEventListener(
      "input",
      () => {
        render(false);
      },
      { signal },
    );

    amountInput.addEventListener(
      "blur",
      () => {
        const amount = parseAmount(amountInput.value);
        if (amount && amount > 0) {
          amountInput.value = formatAmountInput(amount);
        }
      },
      { signal },
    );

    root
      .querySelectorAll("[data-mode], [data-status], [data-vl]")
      .forEach((control) => {
        control.addEventListener("change", () => render(true), { signal });
      });

    render(true);
  }

  setupCalculator();
  document.addEventListener("astro:page-load", setupCalculator);
</script>
