---
import PageFrame from "../components/PageFrame.astro";
import BentoCard from "../components/cards/BentoCard.astro";
import { bentoCards } from "../data/bento";

const visibleCards = bentoCards.filter((card) => card.visible);
---

<PageFrame contentLabel="Portfolio" contentId="work">
  {
    visibleCards.map((card, index) => (
      <BentoCard card={card} style={`animation-delay: ${280 + index * 70}ms`} />
    ))
  }
</PageFrame>
