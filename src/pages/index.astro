---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProfileSidebar from "../components/ProfileSidebar.astro";
import BentoPlaceholder from "../components/cards/BentoPlaceholder.astro";
import { site } from "../data/site";
import { bentoCards } from "../data/bento";
import { getFullName } from "../lib/profile";
import { buildSocialLinks } from "../lib/site-links";

const { profile, cta, ctaSecondary, links } = site;
const social = buildSocialLinks(links);
const fullName = getFullName(profile);
const visibleCards = bentoCards.filter((card) => card.visible);
---

<Layout>
  <div class="mx-auto max-w-[var(--width-container)] px-6 md:px-8">
    <Header />

    <main
      class="pb-20 lg:flex lg:items-start lg:gap-10 xl:gap-12"
      transition:animate="fade"
    >
      <ProfileSidebar
        profile={profile}
        cta={cta}
        ctaSecondary={ctaSecondary}
        social={social}
        transition:persist="profile-sidebar"
      />

      <section
        id="work"
        class="min-w-0 flex-1 grid grid-cols-1 gap-[var(--spacing-bento-gap)] md:grid-cols-2 lg:border-l lg:border-border/30 lg:pl-10 lg:auto-rows-min xl:pl-12"
        aria-label="Portfolio"
      >
        {
          visibleCards.map((card, index) => (
            <BentoPlaceholder
              card={card}
              style={`animation-delay: ${280 + index * 70}ms`}
            />
          ))
        }
      </section>
    </main>

    <Footer name={fullName} email={profile.email} github={links.github} />
  </div>
</Layout>
